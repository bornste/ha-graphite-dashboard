{# Status text for room cards: number of lights that are on (numeric sensor);
   all off returns nothing (normal state, the card hides the empty status) #}
{%- macro lightStatus(entityId) -%}
  {%- set lightCount = states(entityId) | int(-1) -%}
  {%- if lightCount < 0 -%}Nicht verfügbar
  {%- elif lightCount == 0 -%}
  {%- elif lightCount == 1 -%}1 Licht an
  {%- else -%}{{ lightCount }} Lichter an
  {%- endif -%}
{%- endmacro -%}
